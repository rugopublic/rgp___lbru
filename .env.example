APP_NAME="LIKABLOG.RU"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_FORCE_HTTPS=false

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=likablog
DB_USERNAME=likablog
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRODUCT_FILE_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

FILE_TEMP_FOLDER=temp
TEMP_UPLOAD_PATH=temp
MEDIA_IMAGE_MAX_SIZE=5242880
MEDIA_IMAGE_WIDTH=720
MEDIA_IMAGE_HEIGHT=720
MEDIA_IMAGE_QUALITY=0.9
MEDIA_VIDEO_MAX_SIZE=209715200
MEDIA_DOCUMENT_MAX_SIZE=524288000

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="\${APP_NAME}"

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPT_ENABLED=false
YOOKASSA_VAT_CODE=
YOOKASSA_WEBHOOK_IP_VALIDATION=true
YOOKASSA_PAYMENT_SUBJECT=service
YOOKASSA_PAYMENT_MODE=full_payment

SEED_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
